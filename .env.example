# Copier vers .env à la racine. Ne jamais versionner .env.
HOST=127.0.0.1
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=vite_et_gourmand
DB_USER=vg_app
DB_PASSWORD=
DB_SSL=false
# DB_PASSWORD : renseigner localement le secret choisi avec \password vg_app.
# En production : utiliser DB_SSL=true et un certificat de confiance.

# Aucun email réel envoyé par défaut. Activer smtp uniquement volontairement.
EMAIL_MODE=disabled
# EMAIL_MODE=smtp exige TOUS les paramètres ci-dessous et une connexion TLS valide.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Sessions locales uniquement en memoire ; perdues au redemarrage.
NODE_ENV=development
SESSION_STORE=memory
# En production : NODE_ENV=production, SESSION_STORE=postgres et scripts 007/008
# appliques manuellement apres autorisation. Secret aleatoire >= 32 caracteres.
SESSION_SECRET=
# Origine sans slash final ; obligatoire en HTTPS en production.
APP_ORIGIN=
# Mettre 1 seulement derriere un proxy unique maitrise qui termine HTTPS,
# avec le serveur Node inaccessible directement depuis Internet.
TRUST_PROXY_HOPS=0

# Prorata valide par le porteur du projet : prix minimum / minimum * personnes,
# arrondi au centime, puis remise de 10 % a partir de minimum + 5.
ORDER_EXTRA_PRICING=prorata
# Version pedagogique ; fournir de vraies CGV avant une exploitation commerciale.
ORDER_TERMS_VERSION=DEMO-conditions-v1
